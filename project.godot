; Engine configuration file.
; Feito à mão (tudo do jogo é montado por código em scripts/).

config_version=5

[application]

config/name="Fagulha: Em Busca do Sossego"
config/description="Um robô pequeno que anda, corre e voa num vale sossegado. Sem objetivos: passear, olhar, e às vezes desligar uma máquina antiga."
run/main_scene="res://scenes/main.tscn"
boot_splash/bg_color=Color(0.035, 0.05, 0.085, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="terreno"
3d_physics/layer_2="arvores"
3d_physics/layer_3="armadura"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096

[shader_globals]

troca_fator={
"type": "float",
"value": 1.0
}
estilo_novo={
"type": "float",
"value": 1.0
}
robo_capim={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
palha={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
tempo_bichos={
"type": "float",
"value": 0.0
}
fer_chapa={
"type": "sampler2D",
"value": "res://assets/vale/ferrugem/ferrugem_chapa.jpg"
}
fer_grossa={
"type": "sampler2D",
"value": "res://assets/vale/ferrugem/ferrugem_grossa.jpg"
}

[autoload]

BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
